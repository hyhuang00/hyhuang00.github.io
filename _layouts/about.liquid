---
layout: default
---
<div class="post home-page">
  <section class="home-hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">ML Engineer · Google</p>
      <h1 id="intro-title">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero-statement">Research on efficient<br>machine learning systems.</p>
      <p class="hero-topics">{{ page.subtitle }}</p>
      <div class="hero-links">
        <a class="button-primary" href="{{ '/publications/' | relative_url }}">Explore my research <span aria-hidden="true">↗</span></a>
        <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.github_username }}">GitHub</a>
        <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}/">LinkedIn</a>
      </div>
    </div>
    {% if page.profile.image %}
    <figure class="hero-portrait">
      <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Haiyang Huang" width="400" height="600" fetchpriority="high">
      <figcaption>Efficient systems. Interpretable learning.</figcaption>
    </figure>
    {% endif %}
  </section>
  <section class="home-about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="eyebrow">About me</h2>
    <div class="bio">{{ content }}</div>
  </section>
  <section class="research-areas" aria-label="Doctoral research areas">
    <div><span class="area-number">01</span><h3>Efficient ML systems</h3><p>Improving large-scale inference through dynamic gating, expert buffering, and load balancing for mixture-of-experts models.</p><a href="{{ '/projects/moe-inference/' | relative_url }}">Explore the work <span aria-hidden="true">↗</span></a></div>
    <div><span class="area-number">02</span><h3>Interpretable learning</h3><p>Understanding visual concepts and building models whose decisions we can inspect.</p></div>
    <div><span class="area-number">03</span><h3>Data visualization</h3><p>Revealing local and global structure in high-dimensional data.</p></div>
  </section>
  {% if page.selected_papers %}
  <section class="home-section" aria-labelledby="papers-heading">
    <div class="section-heading"><h2 id="papers-heading">Selected research</h2><a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a></div>
    {% include selected_papers.liquid %}
  </section>
  {% endif %}
  {% if page.news and site.announcements.enabled and site.news.size > 0 %}
  <section class="home-section" aria-labelledby="news-heading">
    <div class="section-heading"><h2 id="news-heading">Updates</h2><a href="{{ '/news/' | relative_url }}">Archive <span aria-hidden="true">↗</span></a></div>
    {% include news.liquid limit=true %}
  </section>
  {% endif %}
  <section class="contact-panel" aria-labelledby="contact-heading">
    <div><p class="eyebrow">Get in touch</p><h2 id="contact-heading">Let’s connect.</h2><p>Reach out on LinkedIn for research conversations and collaborations.</p></div>
    <div class="contact-links">
<a class="button-primary" href="https://www.linkedin.com/in/{{ site.linkedin_username }}/">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      <a href="https://orcid.org/{{ site.orcid_id }}">ORCID <span aria-hidden="true">↗</span></a>
      <a href="{{ site.dblp_url }}">DBLP <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>
